# Copy this file to .env (git-ignored) for local dev. Set the REAL values in the
# Render dashboard (Environment tab) for production — never commit real secrets.

# MongoDB connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?appName=Cluster0

# JWT token secret (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret

# M-Pesa Configuration (Safaricom Daraja API)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_safaricom_consumer_key
MPESA_CONSUMER_SECRET=your_safaricom_consumer_secret
MPESA_SHORTCODE=your_paybill_or_store_number
MPESA_PASSKEY=your_lipa_na_mpesa_passkey

# Public Callback URL (Required to receive Lipa Na M-Pesa payment confirmations)
# For local dev, use Ngrok (e.g. https://xxxx.ngrok-free.app/api/mpesa/callback)
CALLBACK_URL=https://your-public-callback-url.com/api/mpesa/callback

# Google Custom Search — powers the admin product image finder (broadest coverage).
#   1) API key:  https://console.cloud.google.com/apis/credentials  (enable "Custom Search API")
#   2) Engine ID (cx): https://programmablesearchengine.google.com  (turn ON "Image search" + "Search the entire web")
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_programmable_search_engine_id

# Africa's Talking SMS (sign-in codes). AT_SENDER_ID only once Safaricom/Airtel approved it.
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=

# TEMPORARY escape hatch while SMS is not delivering: when an SMS fails, the
# sign-in code is shown on screen (so ANYONE can sign in to ANY account).
# Set to false as soon as Africa's Talking delivers codes.
OTP_SCREEN_FALLBACK=true

# M-Pesa callback secret: any random string. Add ?secret=<the same value> to the
# end of CALLBACK_URL. Callbacks without it are ignored (payments are still
# confirmed by querying Safaricom directly).
MPESA_CALLBACK_SECRET=change_me_to_a_random_string

# Development/test mock — auto-confirms every payment. NEVER true in production.
MPESA_MOCK_ENABLED=false

# Firebase service account JSON (raw or base64) — enables real device push.
FCM_SERVICE_ACCOUNT_JSON=

# Local development only: allow the offline JSON-file database when MongoDB is
# unreachable. Production (MONGODB_URI set) refuses to start without MongoDB.
ALLOW_OFFLINE_DB=false
