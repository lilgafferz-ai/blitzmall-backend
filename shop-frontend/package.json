{
  "name": "shop-frontend",
  "version": "0.1.38",
  "private": true,
  "main": "main.js",
  "homepage": "./",
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capgo/capacitor-updater": "^8.49.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node scripts/make-ota-bundle.js",
    "build:web": "react-scripts build",
    "build:strict": "node scripts/build-strict.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "archiver": "^7.0.1",
    "electron": "^42.4.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "electronVersion": "42.3.3",
    "appId": "com.blitzmall.app",
    "productName": "BlitzMall",
    "publish": [
      {
        "provider": "github",
        "owner": "lilgafferz-ai",
        "repo": "blitzmall-backend",
        "releaseType": "release"
      }
    ],
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/app-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlitzMall"
    },
    "mac": {
      "icon": "public/app-icon.ico"
    }
  }
}
