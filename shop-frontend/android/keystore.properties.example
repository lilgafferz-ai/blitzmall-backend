# Play Store release signing — COPY this file to "keystore.properties" (same
# folder) and fill in your real values. The real file is git-ignored.
#
# 1) Generate your signing key ONCE (keep the .jks file + passwords forever —
#    losing them means you can never update the app on Play again):
#
#      keytool -genkey -v -keystore blitzmall-release.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias blitzmall
#
# 2) Point storeFile at that .jks (use double backslashes on Windows paths):

storeFile=C:\\Users\\red\\keys\\blitzmall-release.jks
storePassword=CHANGE_ME
keyAlias=blitzmall
keyPassword=CHANGE_ME
